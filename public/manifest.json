{
    "manifest_version": 3,
    "name": "IaC Module Linker",
    "description": "Converts Terraform module sources into clickable links that take you to the module definition page. Works on GitHub.",
    "permissions": ["tabs", "scripting", "activeTab", "storage"],
    "host_permissions": ["https://github.com/*", "https://registry.terraform.io/*"],
    "version": "0.0.0.17",
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "matches": ["https://github.com/?*"],
            "js": ["contentscript.js"],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "backgroundscript.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "96": "icons/icon96.png",
        "128": "icons/icon128.png"
    }
}
